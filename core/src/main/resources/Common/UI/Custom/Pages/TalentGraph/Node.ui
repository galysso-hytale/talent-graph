$C = "../../Common.ui";
$Sounds = "../../Sounds.ui";

// One frame per state, toggled through Visible by the server. Frames are
// inert to the left click: no hover style, no sound. They carry the events
// the page needs: the cursor entering and leaving (the hover card, where
// the player reads what the talent gives and why it cannot be unlocked)
// and the right click (the detail panel). No client tooltip: the card is
// the tooltip. Backgrounds are 9-slices so the node can be resized without
// redrawing the textures.
@StateFrame = Button {
  Visible: false;
};

@BadgeStyle = LabelStyle(
  FontSize: 12,
  RenderBold: true,
  HorizontalAlignment: Center,
  VerticalAlignment: Center
);

Group {
  Anchor: (Width: 72, Height: 72);

  @StateFrame #Locked {
    Style: (Default: (Background: (TexturePath: "Node/Locked.png", Border: 8)));
  }

  @StateFrame #Available {
    Style: (Default: (Background: (TexturePath: "Node/Available.png", Border: 8)));
  }

  @StateFrame #Unlocked {
    Style: (Default: (Background: (TexturePath: "Node/Unlocked.png", Border: 8)));
  }

  @StateFrame #Maxed {
    Style: (Default: (Background: (TexturePath: "Node/Maxed.png", Border: 8)));
  }

  // A ghost: a prerequisite that names no talent, drawn where the author
  // will look for it (see LiveReload). Dashed frame, no state; a plain
  // client tooltip, since a ghost has nothing but its message.
  @StateFrame #Ghost {
    Style: (Default: (Background: (TexturePath: "Node/Ghost.png", Border: 8)));
    TextTooltipShowDelay: 0.1;
    TextTooltipStyle: $C.@DefaultTextTooltipStyle;
  }

  // The only element the left click reaches, shown solely when the talent
  // can be unlocked right now. Transparent at rest so the state frame shows
  // through.
  Button #Action {
    Visible: false;
    Style: (
      Sounds: $Sounds.@ButtonsLight,
      Hovered: (Background: (TexturePath: "Node/Action_Hovered.png", Border: 8))
    );
  }

  // Icon at the native 64×64 size of the game's item icons.
  Group {
    LayoutMode: CenterMiddle;

    AssetImage #Icon {
      Anchor: (Width: 64, Height: 64);
      FallbackTexturePath: "UI/Custom/Pages/TalentGraph/Icons/Missing.png";
    }
  }

  // Darkens the icon of a locked talent.
  Group #Dim {
    Visible: false;
    Background: (TexturePath: "Node/Dim.png", Border: 8);
  }

  // Author aid: the ring and the "!" of a talent whose entry in the file
  // has a problem; the tooltip of the frame says which.
  Group #Problem {
    Visible: false;
    Background: (TexturePath: "Node/Error.png", Border: 8);
  }

  Group #ProblemBadge {
    Visible: false;
    Anchor: (Left: -6, Top: -6, Width: 18, Height: 18);
    Background: (TexturePath: "Node/Badge.png", Border: 6);
    LayoutMode: CenterMiddle;

    Label {
      Style: (...@BadgeStyle, FontSize: 13, TextColor: #e05a5a);
      Text: "!";
    }
  }

  // Price of the next rank: the number, white when affordable and red
  // otherwise, followed by the talent-point gem.
  Group #Cost {
    Anchor: (Right: -6, Top: -6, Width: 34, Height: 18);
    Background: (TexturePath: "Node/Badge.png", Border: 6);

    Label #CostOk {
      Visible: false;
      Anchor: (Left: 3, Top: 0, Width: 18, Height: 18);
      Style: (...@BadgeStyle, TextColor: #f0f4ff);
      Text: "";
    }

    Label #CostNo {
      Visible: false;
      Anchor: (Left: 3, Top: 0, Width: 18, Height: 18);
      Style: (...@BadgeStyle, TextColor: #e05a5a);
      Text: "";
    }

    Group {
      Anchor: (Right: 4, Top: 5, Width: 8, Height: 8);
      Background: (TexturePath: "Node/Point.png");
    }
  }

  // Progress of a multi-rank talent, up to 5 ranks: a badge on the bottom
  // edge holding one pip per rank, filled once acquired. The server anchors
  // the badge and its pips so the row is centred whatever the rank count.
  Group #Pips {
    Visible: false;
    Background: (TexturePath: "Node/Badge.png", Border: 6);
    Group #Pip1On { Visible: false; Background: (TexturePath: "Node/PipOn.png"); }
    Group #Pip1Off { Visible: false; Background: (TexturePath: "Node/PipOff.png"); }
    Group #Pip2On { Visible: false; Background: (TexturePath: "Node/PipOn.png"); }
    Group #Pip2Off { Visible: false; Background: (TexturePath: "Node/PipOff.png"); }
    Group #Pip3On { Visible: false; Background: (TexturePath: "Node/PipOn.png"); }
    Group #Pip3Off { Visible: false; Background: (TexturePath: "Node/PipOff.png"); }
    Group #Pip4On { Visible: false; Background: (TexturePath: "Node/PipOn.png"); }
    Group #Pip4Off { Visible: false; Background: (TexturePath: "Node/PipOff.png"); }
    Group #Pip5On { Visible: false; Background: (TexturePath: "Node/PipOn.png"); }
    Group #Pip5Off { Visible: false; Background: (TexturePath: "Node/PipOff.png"); }
  }

  // Bottom-centre badge: the check mark of a complete talent, or the rank as
  // text when there are too many ranks for pips.
  Group #RankBadge {
    Visible: false;
    Anchor: (Left: 21, Bottom: -6, Width: 30, Height: 16);
    Background: (TexturePath: "Node/Badge.png", Border: 6);
    LayoutMode: CenterMiddle;

    Label #Rank {
      Visible: false;
      Style: (...@BadgeStyle, FontSize: 11, TextColor: #d6e4ee);
      Text: "";
    }

    Group #Check {
      Visible: false;
      Anchor: (Width: 12, Height: 10);
      Background: (TexturePath: "Node/Check.png");
    }
  }
}
