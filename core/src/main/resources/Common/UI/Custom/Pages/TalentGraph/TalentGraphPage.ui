$C = "../../Common.ui";

@HeaderStyle = LabelStyle(
  FontSize: 15,
  VerticalAlignment: Center,
  RenderUppercase: true,
  TextColor: #b4c8c9,
  FontName: "Secondary",
  RenderBold: true,
  LetterSpacing: 0.5
);

// Input hints, in the style of the tool legends of the game.
@HintStyle = LabelStyle(
  FontSize: 12,
  FontName: "Secondary",
  RenderBold: true,
  RenderUppercase: true,
  VerticalAlignment: Center,
  TextColor: #ffffff(0.8)
);

// Detail panel: the title of the talent and its category headings.
@PanelTitleStyle = LabelStyle(
  FontSize: 18,
  RenderBold: true,
  HorizontalAlignment: Center,
  TextColor: #f0f4ff,
  Wrap: true
);

@PanelMutedStyle = LabelStyle(
  FontSize: 13,
  HorizontalAlignment: Center,
  TextColor: #96a9be,
  Wrap: true
);

@PanelTextStyle = LabelStyle(
  FontSize: 14,
  TextColor: #c9d4e0,
  Wrap: true
);

// One category of a card or panel body: a thin separator (hidden on the
// first one shown), a heading in small capitals, then the lines the
// server appends (Row.ui).
@PanelCategory = Group {
  Visible: false;
  LayoutMode: Top;

  $C.@ContentSeparator #Sep {
    @Anchor = Anchor(Top: 8, Bottom: 8);
  }

  Label #Heading {
    Style: (...$C.@SubtitleStyle, FontSize: 13);
    Anchor: (Bottom: 2);
    Text: "";
  }

  Group #Rows {
    LayoutMode: Top;
  }
};

$C.@PageOverlay {
  LayoutMode: Middle;

  $C.@DecoratedContainer {
    // Parameter overrides must precede properties.
    @CloseButton = true;
    Anchor: (Height: 960, Width: 1600);

    #Title {
      Group {
        LayoutMode: Center;

        Label #PageTitle {
          Style: (...@HeaderStyle, FontName: "Default");
          Text: "Talents";
        }
      }
    }

    #Content {
      LayoutMode: Top;
      Padding: (Full: 9);

      Group #Header {
        LayoutMode: Left;
        Anchor: (Height: 32);
        Padding: (Horizontal: 12);

        // Previous / next graph, by id; the boxes are shown by the server
        // only when several graphs are registered.
        Group #PrevGraphBox {
          Visible: false;
          Anchor: (Width: 32);
          $C.@SmallSecondaryTextButton #PrevGraph {
            @Text = "<";
            @Anchor = Anchor(Width: 32);
            Padding: (Horizontal: 0);
          }
        }

        Label #GraphName {
          Style: (...@HeaderStyle, TextColor: #89899f, HorizontalAlignment: Center);
          Anchor: (Width: 220);
          Text: "";
        }

        Group #NextGraphBox {
          Visible: false;
          Anchor: (Width: 32);
          $C.@SmallSecondaryTextButton #NextGraph {
            @Text = ">";
            @Anchor = Anchor(Width: 32);
            Padding: (Horizontal: 0);
          }
        }

        Group {
          FlexWeight: 1;
          LayoutMode: Center;

          // How to open the detail panel; the server fills the words.
          Label #DetailHint {
            Style: (...@HintStyle, TextColor: #89899f);
            Text: "";
          }
        }

        // Zoom by steps, centred in the header: two large targets beat a
        // slider handle, and each step is one rebuild of the canvas.
        $C.@SmallSecondaryTextButton #ZoomOut {
          @Text = "-";
          @Anchor = Anchor(Width: 32);
          Padding: (Horizontal: 0);
        }

        Label #ZoomLevel {
          Anchor: (Width: 56);
          Style: (...@HeaderStyle, TextColor: #89899f, HorizontalAlignment: Center);
          Text: "100 %";
        }

        $C.@SmallSecondaryTextButton #ZoomIn {
          @Text = "+";
          @Anchor = Anchor(Width: 32);
          Padding: (Horizontal: 0);
        }

        Group {
          FlexWeight: 1;
        }

        Label #Points {
          Style: (...@HeaderStyle, TextColor: #e8a93b);
          Text: "";
        }

        // Talent-point gem, the same symbol as on the price badges.
        Group {
          Anchor: (Left: 6, Top: 10, Bottom: 10, Width: 12);
          Background: (TexturePath: "Node/PointLarge.png");
        }
      }

      // The stage is the window on the canvas. Its size is fixed and known
      // to the server (TalentGraphPage.VIEWPORT_*): the client reports
      // neither wheel nor cursor, so there is no scroll to read back.
      Group #Stage {
        Anchor: (Top: 8, Width: 1582, Height: 864);

        // The canvas holds the whole graph drawn at the current zoom, which
        // the server slides around by re-anchoring #Graph. Neither group has
        // a LayoutMode: their children are placed by their Anchor alone.
        // Nothing clips by itself (a scrolling group with nothing to scroll
        // does not either): the mask, an opaque texture stretched over the
        // canvas, is what cuts the graph at the edges, as MapPage.ui does
        // with its vignette on #MapContainer.
        Group #Canvas {
          Anchor: (Width: 1582, Height: 864);
          Background: (Color: #060b14(0.45));
          MaskTexturePath: "Mask.png";

          Group #Graph {
          }
        }

        // Author aid (see LiveReload): one line over the top of the canvas
        // when the file behind the graph was reloaded with problems, or
        // cannot be read. A button so that it carries a tooltip, which
        // lists every problem. The mark is the cue that owes nothing to
        // colour: "!" for problems, the check of a clean reload.
        Button #Banner {
          Visible: false;
          Anchor: (Left: 12, Top: 12, Width: 1558, Height: 30);
          Style: (Default: (Background: (TexturePath: "Node/Badge.png", Border: 6)));
          TextTooltipShowDelay: 0.1;
          TextTooltipStyle: $C.@DefaultTextTooltipStyle;
          LayoutMode: Left;
          Padding: (Horizontal: 10);

          Label #BannerMark {
            Anchor: (Width: 14);
            Style: (FontSize: 15, RenderBold: true, VerticalAlignment: Center, TextColor: #e05a5a);
            Text: "!";
          }

          Group #BannerCheck {
            Visible: false;
            Anchor: (Top: 10, Bottom: 10, Width: 14);
            LayoutMode: CenterMiddle;

            Group {
              Anchor: (Width: 12, Height: 10);
              Background: (TexturePath: "Node/Check.png");
            }
          }

          Label #BannerText {
            Anchor: (Left: 8);
            Style: (FontSize: 13, VerticalAlignment: Center, TextColor: #f0f4ff);
            Text: "";
          }
        }

        // The whole graph at a glance, and the only way to move the window:
        // a grid of invisible buttons (appended by the server) covers it,
        // each sending the window to the point under it.
        Group #Minimap {
          Anchor: (Right: 12, Bottom: 12, Width: 300, Height: 180);
          Background: (TexturePath: "Node/Badge.png", Border: 6);

          // With a background image the minimap shows it, scaled: the map
          // of the graph is the graph's own picture. Anchored by the server.
          AssetImage #MinimapBackground {
            Visible: false;
          }

          Group #MinimapDots {
          }

          // The rectangle of the window: a faint fill and a 1-unit outline,
          // anchored by the server at each move.
          Group #WindowFill {
            Background: (Color: #ffffff(0.06));
          }
          Group #WindowTop {
            Background: (Color: #f0f4ff(0.75));
          }
          Group #WindowBottom {
            Background: (Color: #f0f4ff(0.75));
          }
          Group #WindowLeft {
            Background: (Color: #f0f4ff(0.75));
          }
          Group #WindowRight {
            Background: (Color: #f0f4ff(0.75));
          }

          Group #MinimapGrid {
          }
        }

        // How to drive the minimap, as a caption on its top edge: the
        // game's own mouse glyphs (the small ones of the tool legends),
        // one word each, in the same frame as the minimap and shown with
        // it. The right-click hint changes with the follow mode, in words
        // and not only in colour.
        Group #MinimapHelp {
          Anchor: (Right: 12, Bottom: 196, Width: 300, Height: 30);
          Background: (TexturePath: "Node/Badge.png", Border: 6);
          LayoutMode: Left;
          Padding: (Horizontal: 8);

          Group {
            Anchor: (Top: 4, Bottom: 4, Width: 22);
            Background: (TexturePath: "../../Common/SmallInputIconMouseLeftClick.png");
          }

          Label {
            Anchor: (Left: 4);
            Style: @HintStyle;
            Text: "Center view";
          }

          Group {
            FlexWeight: 1;
          }

          Group {
            Anchor: (Top: 4, Bottom: 4, Width: 22);
            Background: (TexturePath: "../../Common/SmallInputIconMouseRightClick.png");
          }

          Label #FollowHint {
            Anchor: (Left: 4);
            Style: @HintStyle;
            Text: "Follow cursor";
          }

          Label #FollowingHint {
            Visible: false;
            Anchor: (Left: 4);
            Style: (...@HintStyle, TextColor: #f2c94c);
            Text: "Stop following";
          }
        }

        // The detailed view of one talent, opened by a right click on its
        // node and closed by another, by the cross, or by opening another
        // talent. It holds what the tooltip cannot: the keys as the client
        // has them bound, the values of every rank, the longer texts.
        Group #Detail {
          Visible: false;
          Anchor: (Right: 12, Top: 12, Width: 440, Bottom: 240);
          Background: (TexturePath: "Node/Badge.png", Border: 6);

          Group {
            Anchor: (Left: 16, Top: 16, Right: 16, Bottom: 16);
            LayoutMode: TopScrolling;
            ScrollbarStyle: $C.@DefaultScrollbarStyle;

            Label #DetailTitle {
              Style: @PanelTitleStyle;
              Text: "";
            }

            Label #DetailRank {
              Visible: false;
              Style: @PanelMutedStyle;
              Anchor: (Top: 2);
              Text: "";
            }

            Label #DetailLore {
              Visible: false;
              Style: (...@PanelTextStyle, RenderItalics: true, HorizontalAlignment: Center);
              Anchor: (Top: 8);
              Text: "";
            }

            $C.@PanelSeparatorFancy #DetailSepTop {
              @Anchor = Anchor(Top: 12, Bottom: 4);
              Visible: false;
            }

            @PanelCategory #DetailStats {
            }

            @PanelCategory #DetailMovement {
            }

            @PanelCategory #DetailEffects {
            }

            @PanelCategory #DetailEquipment {
            }

            @PanelCategory #DetailAbilities {
            }

            $C.@PanelSeparatorFancy #DetailSepBottom {
              @Anchor = Anchor(Top: 12, Bottom: 8);
              Visible: false;
            }

            Label #DetailMore {
              Visible: false;
              Style: @PanelTextStyle;
              Text: "";
            }
          }

          $C.@CloseButton #DetailClose {
            Anchor: (Top: -10, Right: -10, Width: 32, Height: 32);
          }
        }

        // The hover card: the tooltip of a node, drawn by the page rather
        // than by the client so that it can hold separators, glyphs and
        // colours. Shown on MouseEntered of a node, anchored beside it by
        // the server, hidden on MouseExited. The outer group stretches to
        // the bottom of the stage so that the card inside takes the height
        // of its content.
        Group #Hover {
          Visible: false;
          LayoutMode: Top;

          Group #HoverCard {
            Background: (TexturePath: "../../Common/TooltipDefaultBackground.png", Border: 24);
            Padding: (Full: 18);
            LayoutMode: Top;

            Label #HoverTitle {
              Style: (...@PanelTitleStyle, FontSize: 16);
              Text: "";
            }

            Label #HoverRank {
              Visible: false;
              Style: @PanelMutedStyle;
              Anchor: (Top: 2);
              Text: "";
            }

            Label #HoverLore {
              Visible: false;
              Style: (...@PanelTextStyle, RenderItalics: true, HorizontalAlignment: Center);
              Anchor: (Top: 6);
              Text: "";
            }

            // Author aid: the problems of the node's entry in the file.
            Label #HoverProblems {
              Visible: false;
              Style: @PanelTextStyle;
              Anchor: (Top: 6);
              Text: "";
            }

            $C.@PanelSeparatorFancy #HoverSepTop {
              @Anchor = Anchor(Top: 10, Bottom: 2);
              Visible: false;
            }

            @PanelCategory #HoverStats {
            }

            @PanelCategory #HoverMovement {
            }

            @PanelCategory #HoverEffects {
            }

            @PanelCategory #HoverEquipment {
            }

            @PanelCategory #HoverAbilities {
            }

            $C.@PanelSeparatorFancy #HoverSepBottom {
              @Anchor = Anchor(Top: 10, Bottom: 6);
              Visible: false;
            }

            // What the player can do with the node right now.
            Label #HoverState {
              Style: @PanelTextStyle;
              Text: "";
            }
          }
        }
      }
    }
  }
}
