# Words of this pack for the talent tooltips. The mod looks these keys up
# before falling back to an asset's Name or to its id: a pack translates
# its own ids here, in as many languages as it has folders for.
# The file must be named talentgraph.lang: the server prefixes each key
# with the file name, and the mod looks up talentgraph.<key>.

effect.Example_Vigor_Regen_1 = Slow regeneration
effect.Example_Vigor_Regen_2 = Regeneration

# Costs and cooldowns are not written here: the tooltip reads them from the
# root interaction and the StatsCondition at the top of its chain.
ability.Example_Bolt_1 = Arcane bolt I
ability.Example_Bolt_2 = Arcane bolt II
ability.Example_Bolt_3 = Arcane bolt III (crouch and hold: two bolts for 20 mana)
ability.Example_Mend_1 = Mend I: 15 health
ability.Example_Mend_2 = Mend II: 30 health
ability.Example_Nova_1 = Nova I: 15 fire damage around you
ability.Example_Nova_2 = Nova II: 25 fire damage around you
ability.Example_Storm = Storm: Nova II, sooner
ability.Example_Blink = Blink
